MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional if the database name is omitted from MONGODB_URI
MONGODB_DB=activewear

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate each with at least 32 random characters. Keep separate.
SESSION_SECRET=
ADMIN_BOOTSTRAP_SECRET=

# Optional: canonical URL used by the Organization JSON-LD metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
